APP_NAME="Moje fakturace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
INVOICE_TEST_PURGE_UUIDS=

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central

DB_CENTRAL_HOST=
DB_CENTRAL_PORT=3306
DB_CENTRAL_DATABASE=
DB_CENTRAL_USERNAME=
DB_CENTRAL_PASSWORD=

DB_BUSINESS_1_HOST=
DB_BUSINESS_1_PORT=3306
DB_BUSINESS_1_DATABASE=
DB_BUSINESS_1_USERNAME=
DB_BUSINESS_1_PASSWORD=

DB_BUSINESS_2_HOST=
DB_BUSINESS_2_PORT=3306
DB_BUSINESS_2_DATABASE=
DB_BUSINESS_2_USERNAME=
DB_BUSINESS_2_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=central
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
INVOICE_DOCUMENTS_ROOT=
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=15
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
